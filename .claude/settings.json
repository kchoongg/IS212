{
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run test:coverage *)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git branch -a *)",
      "Bash(git branch --list *)",
      "Bash(python .claude/skills/generate-test-cases/scripts/fill_template.py *)",
      "Bash(python3 .claude/skills/generate-test-cases/scripts/fill_template.py *)",
      "Bash(npm run coverage:changed *)",
      "Bash(npm run test-cases:check *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-stop-coverage.mts\"",
            "timeout": 300,
            "statusMessage": "Checking the changed lines are tested..."
          }
        ]
      }
    ]
  }
}
