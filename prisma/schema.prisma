// ConnectSphere — database schema
// Conventions (see DOCUMENTATION.md § Building the Database From Scratch):
//   - UUID primary keys
//   - camelCase fields, snake_case columns via @map
//   - plural snake_case table names via @@map
//
// Business rules (booking conflicts, equipment availability, registration
// capacity, draft completeness) are enforced in route/service code, NOT here.
// See data_dictionary.md § "Rules that live in application code".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITY
// ---------------------------------------------------------------------------

/// Client companies. The access boundary for external users: an Organiser
/// should not see events belonging to an unrelated client.
model Organisation {
  id           String   @id @default(uuid())
  name         String   @unique
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  createdAt    DateTime @default(now()) @map("created_at")

  users  User[]
  events Event[]

  @@map("organisations")
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String  @map("password_hash")
  /// Display name. Routes send this as `name`; it is stored as full_name.
  fullName     String  @map("full_name")
  phone        String?
  /// organiser | coordinator | venue_staff | tech_support | attendee | ops_manager
  role         String

  /// NULL for internal ConnectSphere staff, set for external users.
  organisationId String? @map("organisation_id")
  /// Internal staff only.
  department     String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [organisationId], references: [id])

  organisedEvents        Event[]                @relation("EventOrganiser")
  coordinatedEvents      Event[]                @relation("EventCoordinator")
  statusChanges          EventStatusHistory[]
  clarificationsRaised   ClarificationRequest[] @relation("ClarificationRequester")
  changeRequestsRaised   EventChangeRequest[]   @relation("ChangeRequester")
  changeRequestsReviewed EventChangeRequest[]   @relation("ChangeReviewer")
  bookingsRequested      VenueBooking[]         @relation("BookingRequester")
  bookingsDecided        VenueBooking[]         @relation("BookingDecider")
  unavailabilityCreated  VenueUnavailability[]
  equipmentRequested     EquipmentRequest[]     @relation("EquipmentRequester")
  equipmentReviewed      EquipmentRequest[]     @relation("EquipmentReviewer")
  registrations          Registration[]
  notifications          Notification[]

  @@index([role])
  @@index([organisationId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// VENUES
// ---------------------------------------------------------------------------

model Venue {
  id          String  @id @default(uuid())
  /// Short human key staff say aloud, e.g. "MAR-GH".
  code        String  @unique
  name        String
  description String?

  /// Filterable location. Do not put these in `address`.
  building String
  floor    String?
  address  String?

  /// Absolute ceiling. Per-layout capacity (usually lower) is in VenueLayout.
  maxCapacity Int @map("max_capacity")

  /// "HH:MM", 24-hour. Stored as text so it is trivial to handle in JS and Zod;
  /// zero-padded values compare correctly with < and >.
  opensAt  String @default("08:00") @map("opens_at")
  closesAt String @default("22:00") @map("closes_at")

  /// Optional room occupancy either side of the published times.
  setupMinutes    Int @default(0) @map("setup_minutes")
  teardownMinutes Int @default(0) @map("teardown_minutes")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  layouts        VenueLayout[]
  facilities     VenueFacility[]
  bookings       VenueBooking[]
  unavailability VenueUnavailability[]
  /// Equipment kept at this venue (Equipment.locationVenueId).
  equipmentHere  Equipment[]           @relation("EquipmentLocation")

  @@index([isActive, building, maxCapacity])
  @@map("venues")
}

/// Which layouts a room supports and how many fit in each. The same room seats
/// 500 theatre-style but 250 as a classroom, so capacity belongs here, not on
/// Venue — this is what makes suitability checking correct.
model VenueLayout {
  id         String @id @default(uuid())
  venueId    String @map("venue_id")
  /// theatre | classroom | boardroom | banquet | exhibition | u_shape | cabaret
  layoutName String @map("layout_name")
  capacity   Int

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, layoutName])
  @@index([layoutName, capacity])
  @@map("venue_layouts")
}

/// A named capability a room can have. One table for both search filters;
/// `category` keeps them separate in the UI.
model Facility {
  id       String @id @default(uuid())
  name     String @unique
  /// facility | accessibility
  category String

  venues            VenueFacility[]
  eventRequirements EventFacilityRequirement[]

  @@index([category])
  @@map("facilities")
}

model VenueFacility {
  venueId    String @map("venue_id")
  facilityId String @map("facility_id")

  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([venueId, facilityId])
  @@map("venue_facilities")
}

// ---------------------------------------------------------------------------
// EVENTS
// ---------------------------------------------------------------------------

model Event {
  id          String  @id @default(uuid())
  /// A user-facing, auto-generated reference number (e.g. "EVT-000123" via
  /// eventReference() in src/lib/format.ts). Unlike `id` (an opaque UUID
  /// that changes on every reseed) or `seedKey` (internal, seed-data only),
  /// this is meant to be shown to every role, including an Attendee - see
  /// ATTENDEE_EVENT_FIELDS in src/lib/permissions.ts.
  sequenceNumber Int @unique @default(autoincrement()) @map("sequence_number")
  /// A stable natural key for seeded/demo events, e.g. "confirmed_claims" -
  /// the same value prisma/seed.ts's own EventSeed.key already carried, just
  /// never persisted until now. NULL for every event raised through the app
  /// itself (POST /api/events): those have no equivalent concept, and their
  /// `id` is already durable in practice since production is never reseeded.
  /// See SCHEMA_REFERENCE.md: "Event has no unique identifier at all" - this
  /// is what closes that gap. `id` alone isn't enough because a reseed
  /// truncates and reinserts every row with fresh UUIDs (deleteMany(), not
  /// TRUNCATE ... RESTART IDENTITY), so nothing about `id` survives a reseed
  /// to let a test fixture, ticket, report or integration refer back to "the
  /// same event".
  seedKey     String? @unique @map("seed_key")
  title       String?
  description String?
  purpose     String?
  category    String?

  organiserId    String  @map("organiser_id")
  /// The client this event belongs to. Nullable for now: the register route
  /// does not yet assign users to an organisation. See the mismatch report.
  organisationId String? @map("organisation_id")
  /// NULL until an Ops Manager assigns one — this is what separates
  /// `submitted` from `under_review`.
  coordinatorId  String? @map("coordinator_id")

  /// draft | submitted | under_review | approved | planning | confirmed |
  /// completed | cancelled | rejected | postponed
  status String @default("draft")

  /// Current agreed schedule. Proposed changes live in EventChangeRequest.
  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  expectedAttendance  Int?    @map("expected_attendance")
  /// Matched against VenueLayout.layoutName.
  preferredLayout     String? @map("preferred_layout")
  accessibilityNotes  String? @map("accessibility_notes")
  specialRequirements String? @map("special_requirements")

  registrationEnabled  Boolean   @default(false) @map("registration_enabled")
  /// Seats open to the public. Not the same as expectedAttendance.
  registrationCapacity Int?      @map("registration_capacity")
  registrationOpensAt  DateTime? @map("registration_opens_at")
  registrationClosesAt DateTime? @map("registration_closes_at")

  rejectionReason    String? @map("rejection_reason")
  cancellationReason String? @map("cancellation_reason")

  submittedAt DateTime? @map("submitted_at")
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organiser    User          @relation("EventOrganiser", fields: [organiserId], references: [id])
  organisation Organisation? @relation(fields: [organisationId], references: [id])
  coordinator  User?         @relation("EventCoordinator", fields: [coordinatorId], references: [id])

  facilityRequirements EventFacilityRequirement[]
  statusHistory        EventStatusHistory[]
  clarifications       ClarificationRequest[]
  changeRequests       EventChangeRequest[]
  sessions             EventSession[]
  venueBookings        VenueBooking[]
  equipmentRequests    EquipmentRequest[]
  registrations        Registration[]
  notifications        Notification[]

  @@index([organiserId, status])
  @@index([organisationId, status])
  @@index([coordinatorId, status])
  @@index([status, startsAt])
  @@map("events")
}

/// A multi-session event's individual sessions (briefing #74: "sessions may
/// have different timings and operational requirements, including different
/// venues, equipment requirements and attendance limits"). Optional: a
/// single-session event has zero rows here and its VenueBooking /
/// EquipmentRequest rows link to the Event directly (sessionId null), exactly
/// as before this model existed. A multi-session event creates one row per
/// session and scopes each session's own bookings/requests to it.
model EventSession {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  /// e.g. "Day 1 Morning" — optional, purely a display label.
  label   String?

  startsAt           DateTime @map("starts_at")
  endsAt             DateTime @map("ends_at")
  expectedAttendance Int?     @map("expected_attendance")
  preferredLayout    String?  @map("preferred_layout")

  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  venueBookings     VenueBooking[]
  equipmentRequests EquipmentRequest[]

  @@index([eventId, startsAt])
  @@map("event_sessions")
}

model EventFacilityRequirement {
  eventId     String  @map("event_id")
  facilityId  String  @map("facility_id")
  /// false = nice-to-have; must NOT disqualify a venue.
  isMandatory Boolean @default(true) @map("is_mandatory")

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([eventId, facilityId])
  @@map("event_facility_requirements")
}

/// Audit trail of status changes. Event.status holds only the current value.
model EventStatusHistory {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  /// NULL on creation.
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  changedBy  String?  @map("changed_by")
  changedAt  DateTime @default(now()) @map("changed_at")
  reason     String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [changedBy], references: [id])

  @@index([eventId, changedAt])
  @@map("event_status_history")
}

/// The coordinator ↔ organiser review loop. Repeats, so each round is a row.
model ClarificationRequest {
  id              String    @id @default(uuid())
  eventId         String    @map("event_id")
  requestedBy     String    @map("requested_by")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  message         String
  /// open | answered | closed
  status          String    @default("open")
  responseMessage String?   @map("response_message")
  respondedAt     DateTime? @map("responded_at")

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requester User  @relation("ClarificationRequester", fields: [requestedBy], references: [id])

  @@index([eventId, status])
  @@map("clarification_requests")
}

/// Proposed changes. NOT applied to the event until approved.
model EventChangeRequest {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  requestedBy String   @map("requested_by")
  requestedAt DateTime @default(now()) @map("requested_at")
  reason      String

  /// NULL means "not changing this field".
  proposedStartsAt   DateTime? @map("proposed_starts_at")
  proposedEndsAt     DateTime? @map("proposed_ends_at")
  proposedAttendance Int?      @map("proposed_attendance")
  otherChanges       String?   @map("other_changes")

  /// true = date/time/attendance changed → re-check venue and equipment.
  isSignificant Boolean @default(false) @map("is_significant")

  /// pending | approved | rejected | withdrawn
  status      String    @default("pending")
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewNotes String?   @map("review_notes")

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requester User  @relation("ChangeRequester", fields: [requestedBy], references: [id])
  reviewer  User? @relation("ChangeReviewer", fields: [reviewedBy], references: [id])

  @@index([eventId, status])
  @@map("event_change_requests")
}

// ---------------------------------------------------------------------------
// BOOKINGS
// ---------------------------------------------------------------------------

model VenueBooking {
  id         String  @id @default(uuid())
  eventId    String  @map("event_id")
  /// Set only for a multi-session event's session-specific booking. NULL means
  /// this booking applies to the whole (single-session) event, as before.
  sessionId  String? @map("session_id")
  venueId    String  @map("venue_id")
  /// What Venue Staff physically set up.
  layoutName String? @map("layout_name")

  /// Copied from the event at request time — NOT read live. Changing an event
  /// must not silently move an approved booking.
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// pending | approved | rejected | cancelled. Only `approved` blocks a venue.
  status           String    @default("pending")
  requestedBy      String    @map("requested_by")
  requestedAt      DateTime  @default(now()) @map("requested_at")
  requirementsNote String?   @map("requirements_note")
  decidedBy        String?   @map("decided_by")
  decidedAt        DateTime? @map("decided_at")
  /// Required when rejecting — enforced in route code.
  decisionReason   String?   @map("decision_reason")

  /// Manage Venue Catalogue (discussion board #120, #122): set when a venue
  /// edit or retirement may have invalidated this booking. The booking itself
  /// is deliberately NOT changed — a room that no longer fits is a judgement
  /// call for the assigned Coordinator, who is notified. Rules and reason
  /// codes live in src/lib/venueImpact.ts.
  needsReview  Boolean   @default(false) @map("needs_review")
  /// Which impact rules fired, as comma-separated codes: venue_retired |
  /// layout_removed | layout_capacity_below_attendance |
  /// max_capacity_below_attendance | mandatory_facility_removed. A later edit
  /// merges its reasons into this list rather than overwriting it.
  reviewReason String?   @map("review_reason")
  flaggedAt    DateTime? @map("flagged_at")

  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session   EventSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  venue     Venue         @relation(fields: [venueId], references: [id])
  requester User          @relation("BookingRequester", fields: [requestedBy], references: [id])
  decider   User?         @relation("BookingDecider", fields: [decidedBy], references: [id])

  @@index([venueId, status, startsAt, endsAt])
  @@index([eventId, status])
  @@index([sessionId])
  /// The Coordinator's review queue: flagged bookings, most recent first.
  @@index([needsReview, flaggedAt])
  @@map("venue_bookings")
}

/// Maintenance blocks. No event, no requester, no approval step — which is why
/// this is separate from VenueBooking.
model VenueUnavailability {
  id        String   @id @default(uuid())
  venueId   String   @map("venue_id")
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  /// maintenance | renovation | safety | internal_activity | other
  reason    String
  notes     String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  venue   Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  creator User  @relation(fields: [createdBy], references: [id])

  @@index([venueId, startsAt, endsAt])
  @@map("venue_unavailability")
}

// ---------------------------------------------------------------------------
// EQUIPMENT
// ---------------------------------------------------------------------------

/// Tracked by quantity, not by serial number: a coordinator requests
/// "3 projectors", never three specific units.
model Equipment {
  id          String  @id @default(uuid())
  name        String  @unique
  /// AV | IT | Staging | Networking | Accessibility
  category    String?
  description String?

  totalQuantity         Int @map("total_quantity")
  /// Out of service. Availability = total − maintenance − reserved.
  quantityInMaintenance Int @default(0) @map("quantity_in_maintenance")

  isActive Boolean @default(true) @map("is_active")

  /// Where this item is kept (SPM-48; customer Q&A #2: equipment has a
  /// physical location, and moving it between venues takes transfer and
  /// preparation time). NULL means ConnectSphere's own storage - the default,
  /// because after every event equipment is returned there for inspection
  /// before it becomes available again. Set to a venue only for kit that lives
  /// there; no transfer time is then added for an event at that same venue.
  /// A link rather than free text so the "already at the venue" comparison
  /// cannot be broken by a typo, and not a fake "storage" Venue row, which
  /// would carry capacity/layout/facility fields that mean nothing here.
  locationVenueId String? @map("location_venue_id")

  locationVenue Venue?             @relation("EquipmentLocation", fields: [locationVenueId], references: [id], onDelete: SetNull)
  requests      EquipmentRequest[]

  @@map("equipment")
}

/// Request and reservation in one table: a reservation only ever comes from a
/// request, so splitting them made two rows describe one thing.
model EquipmentRequest {
  id          String  @id @default(uuid())
  eventId     String  @map("event_id")
  /// Set only for a multi-session event's session-specific request. NULL means
  /// this request applies to the whole (single-session) event, as before.
  sessionId   String? @map("session_id")
  equipmentId String  @map("equipment_id")

  quantityRequested Int  @map("quantity_requested")
  /// What Tech Support could commit. NULL until reviewed.
  quantityReserved  Int? @map("quantity_reserved")

  technicalRequirements String? @map("technical_requirements")

  /// Usually wider than the event — kit leaves early and returns late.
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// requested | under_review | reserved | partially_fulfilled | unavailable | cancelled
  status      String    @default("requested")
  requestedBy String    @map("requested_by")
  requestedAt DateTime  @default(now()) @map("requested_at")
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  staffNotes  String?   @map("staff_notes")

  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session   EventSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  equipment Equipment     @relation(fields: [equipmentId], references: [id])
  requester User          @relation("EquipmentRequester", fields: [requestedBy], references: [id])
  reviewer  User?         @relation("EquipmentReviewer", fields: [reviewedBy], references: [id])

  // Uniqueness is enforced by two Postgres PARTIAL unique indexes, created
  // directly in migration 20260919100000_add_partial_unique_equipment_request_session
  // — not expressible as a single `@@unique` here, since Prisma's schema DSL
  // has no WHERE clause for indexes. A single (eventId, equipmentId) index
  // can't do both "dedupe whole-event requests" AND "allow two different
  // sessions of one event to request the same item", because Postgres treats
  // NULL as distinct in a unique index, so a naive 3-column
  // (eventId, sessionId, equipmentId) version would stop deduplicating
  // whole-event requests (sessionId NULL, the common case) entirely. The two
  // partial indexes split the rule instead of trying to force one index to
  // do it:
  //   - unique (eventId, equipmentId)             WHERE sessionId IS NULL
  //   - unique (eventId, sessionId, equipmentId)   WHERE sessionId IS NOT NULL
  // Do not add `@@unique([eventId, equipmentId])` back here — `prisma
  // migrate dev` would try to reconcile schema.prisma against the database
  // and could drop these partial indexes, since it doesn't know about them.
  @@index([equipmentId, status, startsAt, endsAt])
  @@index([sessionId])
  @@map("equipment_requests")
}

// ---------------------------------------------------------------------------
// REGISTRATION
// ---------------------------------------------------------------------------

model Registration {
  id         String @id @default(uuid())
  eventId    String @map("event_id")
  attendeeId String @map("attendee_id")
  /// registered | waitlisted | withdrawn | attended
  status     String @default("registered")

  registeredAt DateTime  @default(now()) @map("registered_at")
  withdrawnAt  DateTime? @map("withdrawn_at")

  /// The attendee's own needs, not the event's.
  dietaryRequirements       String? @map("dietary_requirements")
  accessibilityRequirements String? @map("accessibility_requirements")

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee User  @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  /// Required by src/app/api/registrations/route.ts, which detects duplicate
  /// sign-ups by catching the Postgres unique-constraint error rather than
  /// checking first. See the mismatch report for how withdrawal + re-register
  /// is handled given this constraint.
  @@unique([eventId, attendeeId])
  @@index([eventId, status])
  @@index([attendeeId, status])
  @@map("registrations")
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------------------------

model Notification {
  id          String   @id @default(uuid())
  recipientId String   @map("recipient_id")
  type        String
  title       String
  body        String
  eventId     String?  @map("event_id")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  recipient User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  event     Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}
