@startuml
title <size:24>System Context View: ConnectSphere</size>\n<size:24>The environment ConnectSphere operates in.</size>

set separator none
top to bottom direction
skinparam ranksep 60
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person,External Person
  .Element-RWxlbWVudCxQZXJzb24sRXh0ZXJuYWwgUGVyc29u {
    BackgroundColor: #999999;
    LineColor: #6b6b6b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship,ContextRel
  .Relationship-UmVsYXRpb25zaGlwLENvbnRleHRSZWw= {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
  }
</style>

person "==Event Organiser\n<size:16>[Person]</size>\n\nExternal client representative who submits event requests and communicates requirements." <<Element-RWxlbWVudCxQZXJzb24sRXh0ZXJuYWwgUGVyc29u>> as EventOrganiser
person "==Ops Manager\n<size:16>[Person]</size>\n\nAssigns an Event Coordinator to each submitted request from the unassigned queue." <<Element-RWxlbWVudCxQZXJzb24=>> as OpsManager
person "==Event Coordinator\n<size:16>[Person]</size>\n\nReviews event requests, requests venue bookings and equipment, and confirms events." <<Element-RWxlbWVudCxQZXJzb24=>> as EventCoordinator
person "==Venue Staff\n<size:16>[Person]</size>\n\nManages venue information, availability, and booking decisions." <<Element-RWxlbWVudCxQZXJzb24=>> as VenueStaff
person "==Technical Support Staff\n<size:16>[Person]</size>\n\nManages equipment records, availability, and reservations." <<Element-RWxlbWVudCxQZXJzb24=>> as TechnicalSupportStaff
person "==Attendee\n<size:16>[Person]</size>\n\nExternal participant who registers for confirmed events." <<Element-RWxlbWVudCxQZXJzb24sRXh0ZXJuYWwgUGVyc29u>> as Attendee
rectangle "==ConnectSphere\n<size:16>[Software System]</size>\n\nLets ConnectSphere staff and clients plan events, book venues, reserve equipment, and manage attendee registration." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ConnectSphere

EventOrganiser --> ConnectSphere <<Relationship-UmVsYXRpb25zaGlwLENvbnRleHRSZWw=>> : "Submits and edits event requests, tracks status using"
OpsManager --> ConnectSphere <<Relationship-UmVsYXRpb25zaGlwLENvbnRleHRSZWw=>> : "Assigns coordinators to unassigned requests using"
EventCoordinator --> ConnectSphere <<Relationship-UmVsYXRpb25zaGlwLENvbnRleHRSZWw=>> : "Reviews requests, confirms events using"
VenueStaff --> ConnectSphere <<Relationship-UmVsYXRpb25zaGlwLENvbnRleHRSZWw=>> : "Manages venue catalogue and booking approvals using"
TechnicalSupportStaff --> ConnectSphere <<Relationship-UmVsYXRpb25zaGlwLENvbnRleHRSZWw=>> : "Manages equipment catalogue and reservations using"
Attendee --> ConnectSphere <<Relationship-UmVsYXRpb25zaGlwLENvbnRleHRSZWw=>> : "Registers for events and views event details using"

@enduml