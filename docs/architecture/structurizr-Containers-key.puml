rectangle "==Container" <<Element-RWxlbWVudCxDb250YWluZXI=>>

database "==Container, Database" <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>>

person "==Person" <<Element-RWxlbWVudCxQZXJzb24=>>

person "==Person, External Person" <<Element-RWxlbWVudCxQZXJzb24sRXh0ZXJuYWwgUGVyc29u>>

