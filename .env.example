# Copy to .env and fill in. .env is gitignored; never commit real values.

# Your own database: a Neon branch (direct connection string, not -pooler,
# with ?sslmode=require) or a local Postgres. Never the team's shared branch
# for integration or end-to-end tests - they refuse anything not on localhost.
DATABASE_URL=

# Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# npm run trace (docs/traceability) - reads Jira project SPM, never writes.
# The token is an Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://kkchoong.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
