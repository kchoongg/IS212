/**
 * Writes docs/architecture/class-diagram.puml, a PlantUML class diagram of the
 * data model, from prisma/schema.prisma. Run it after any schema change, in
 * the same PR:
 *
 *   npx prisma generate        # the diagram is read from the generated client
 *   npm run docs:class-diagram
 *
 * Fields and relations come from Prisma's own parse of the schema (the DMMF
 * the generated client carries), so the diagram cannot disagree with the
 * client about a type, a nullable column or a foreign key. Only the grouping
 * is read from the schema file itself: each model goes in the package of the
 * `// SECTION` heading above it.
 *
 * Multiplicities, read from the side that holds the foreign key:
 *   - the referenced end is "1" when the foreign key is required, "0..1" when
 *     it is nullable;
 *   - the holding end is "*" when the other model has a list of them, "0..1"
 *     when it has at most one (a one-to-one).
 * A relation that cascades on delete is drawn as a composition (filled
 * diamond on the owner); any other as a plain association.
 *
 * Runs with plain `node` (Node 24 strips the types).
 */

import { readFileSync, writeFileSync } from "node:fs";
import { createRequire } from "node:module";

interface Field {
  name: string;
  kind: "scalar" | "object" | "enum" | "unsupported";
  type: string;
  isList: boolean;
  isRequired: boolean;
  isId: boolean;
  isUnique: boolean;
  isUpdatedAt: boolean;
  relationName?: string;
  relationFromFields?: string[];
  relationOnDelete?: string;
}

interface Model {
  name: string;
  fields: Field[];
  primaryKey: { fields: string[] } | null;
}

const SCHEMA = "prisma/schema.prisma";
const OUTPUT = "docs/architecture/class-diagram.puml";

const require = createRequire(import.meta.url);
const { Prisma } = require("@prisma/client");
const models: Model[] = Prisma.dmmf.datamodel.models;

/// Model name → the section heading it sits under ("IDENTITY", "VENUES", ...).
function sectionsOf(schema: string): Map<string, string> {
  const sections = new Map<string, string>();
  let current = "OTHER";
  const lines = schema.split(/\r?\n/);
  lines.forEach((line, i) => {
    const heading = /^\/\/ ([A-Z][A-Z ]+)$/.exec(line);
    if (heading && lines[i - 1]?.startsWith("// ---")) current = heading[1].trim();
    const model = /^model (\w+)/.exec(line);
    if (model) sections.set(model[1], current);
  });
  return sections;
}

function fieldLine(model: Model, field: Field, foreignKeys: Set<string>): string {
  const marks = [
    field.isId || model.primaryKey?.fields.includes(field.name) ? "PK" : null,
    foreignKeys.has(field.name) ? "FK" : null,
    field.isUnique ? "unique" : null,
  ].filter(Boolean);
  const type = `${field.type}${field.isList ? "[]" : ""}${field.isRequired ? "" : "?"}`;
  return `  ${field.name} : ${type}${marks.length ? ` {${marks.join(", ")}}` : ""}`;
}

function classBlock(model: Model): string {
  const foreignKeys = new Set(model.fields.flatMap((f) => f.relationFromFields ?? []));
  const scalars = model.fields.filter((f) => f.kind !== "object");
  return [`  class ${model.name} {`, ...scalars.map((f) => `  ${fieldLine(model, f, foreignKeys)}`), "  }"].join("\n");
}

/// One line per relation, written from the model holding the foreign key.
function relationLines(): string[] {
  const lines: string[] = [];
  for (const holder of models) {
    for (const field of holder.fields) {
      if (field.kind !== "object" || !field.relationFromFields?.length) continue;
      const target = models.find((m) => m.name === field.type)!;
      const back = target.fields.find((f) => f.relationName === field.relationName && f !== field);
      const targetEnd = field.isRequired ? "1" : "0..1";
      const holderEnd = back?.isList ? "*" : "0..1";
      const link = field.relationOnDelete === "Cascade" ? "*--" : "<--";
      lines.push(`${target.name} "${targetEnd}" ${link} "${holderEnd}" ${holder.name} : ${field.name}`);
    }
  }
  return lines;
}

const sections = sectionsOf(readFileSync(SCHEMA, "utf8"));
const packages = [...new Set(models.map((m) => sections.get(m.name) ?? "OTHER"))];

const diagram = [
  "' GENERATED by scripts/class-diagram.mts from prisma/schema.prisma - do not edit by hand.",
  "' Regenerate: npx prisma generate && npm run docs:class-diagram",
  "@startuml class-diagram",
  "title ConnectSphere data model (prisma/schema.prisma)",
  "hide circle",
  "hide methods",
  "skinparam classAttributeIconSize 0",
  "skinparam linetype ortho",
  "",
  ...packages.flatMap((name) => [
    `package "${name[0]}${name.slice(1).toLowerCase()}" {`,
    ...models.filter((m) => (sections.get(m.name) ?? "OTHER") === name).map(classBlock),
    "}",
    "",
  ]),
  ...relationLines(),
  "",
  "legend right",
  "  {PK} primary key, {FK} foreign key, Type? nullable",
  "  Filled diamond: composition - the row is deleted with its owner (onDelete: Cascade)",
  "  Open arrow: association to the referenced row - no cascade",
  "  Statuses and roles are strings; their values are documented in schema.prisma.",
  "endlegend",
  "@enduml",
  "",
].join("\n");

writeFileSync(OUTPUT, diagram);
console.log(`Wrote ${OUTPUT}: ${models.length} models, ${relationLines().length} relations.`);
